#include <iostream>
#include <vector>
#include <algorithm>
#include <queue>
using namespace std;

// Returns true if all meetings can be attended.
bool can_attend_all(vector<pair<int, int>> events) {
    sort(events.begin(), events.end());

    for (int i = 1; i < events.size(); i++) {
        if (events[i].first < events[i - 1].second) {
            return false;
        }
    }

    return true;
}

// Returns the minimum number of rooms required.
int min_rooms_required(vector<pair<int, int>> events) {
    if (events.empty()) {
        return 0;
    }

    sort(events.begin(), events.end());

    // Min-heap stores end times of ongoing meetings.
    priority_queue<int, vector<int>, greater<int>> minHeap;

    int maxRooms = 0;

    for (const auto& event : events) {
        int start = event.first;
        int end = event.second;

        // Reuse rooms whose meetings have ended.
        while (!minHeap.empty() && minHeap.top() <= start) {
            minHeap.pop();
        }

        // Allocate a room for the current meeting.
        minHeap.push(end);

        // Track the maximum number of simultaneous meetings.
        maxRooms = max(maxRooms, (int)minHeap.size());
    }

    return maxRooms;
}

int main() {
    vector<pair<int, int>> events1 = {
        {9, 10}, {10, 11}, {11, 12}
    };

    cout << boolalpha << can_attend_all(events1) << '\n';
    cout << min_rooms_required(events1) << '\n';

    vector<pair<int, int>> events2 = {
        {9, 11}, {10, 12}, {13, 14}
    };

    cout << can_attend_all(events2) << '\n';
    cout << min_rooms_required(events2) << '\n';

    vector<pair<int, int>> events3 = {
        {9, 12}, {10, 13}, {11, 14}
    };

    cout << can_attend_all(events3) << '\n';
    cout << min_rooms_required(events3) << '\n';

    return 0;
}
